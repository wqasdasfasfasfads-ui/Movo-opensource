@echo off
chcp 65001 >nul
setlocal
title Movo - installer
set "DIR=%LOCALAPPDATA%\Movo"
set "LIB=C:\movo\library"
if not exist "%DIR%" mkdir "%DIR%"
if exist "%DIR%\src" rmdir /s /q "%DIR%\src"
mkdir "%DIR%\src"
if exist "%DIR%\libsrc" rmdir /s /q "%DIR%\libsrc"
mkdir "%DIR%\libsrc"

echo [1/5] Unpacking Movo files...
call :extract ICO "%DIR%\movo.ico"
if errorlevel 1 goto :fail
call :extract LIBICO "%DIR%\movolib.ico"
if errorlevel 1 goto :fail
call :extract S1 "%DIR%\src\Values.cs"
if errorlevel 1 goto :fail
call :extract S2 "%DIR%\src\Ast.cs"
if errorlevel 1 goto :fail
call :extract S3 "%DIR%\src\Parser.cs"
if errorlevel 1 goto :fail
call :extract S4 "%DIR%\src\Interp.cs"
if errorlevel 1 goto :fail
call :extract S5 "%DIR%\src\Builtins.cs"
if errorlevel 1 goto :fail
call :extract S6 "%DIR%\src\Program.cs"
if errorlevel 1 goto :fail
call :extract S7 "%DIR%\src\Gui1.cs"
if errorlevel 1 goto :fail
call :extract S8 "%DIR%\src\Gui2.cs"
if errorlevel 1 goto :fail
call :extract S9 "%DIR%\src\Gui3.cs"
if errorlevel 1 goto :fail
call :extract S10 "%DIR%\src\MovoInstall.cs"
if errorlevel 1 goto :fail
call :extract S11 "%DIR%\src\Host.cs"
if errorlevel 1 goto :fail
call :extract S12 "%DIR%\libsrc\Web.cs"
if errorlevel 1 goto :fail
call :extract S13 "%DIR%\libsrc\Browser.cs"
if errorlevel 1 goto :fail

echo [2/5] Building movo.exe ^(the compiler is already part of Windows, nothing to install^)...
set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"
if not exist "%CSC%" (
  echo .NET Framework 4 ^(csc.exe^) was not found. It is included in Windows 7/8/10/11 by default.
  goto :fail
)
if exist "%DIR%\movo.exe" del /f /q "%DIR%\movo.exe" >nul 2>&1
"%CSC%" /nologo /optimize+ /codepage:65001 /target:exe /out:"%DIR%\movo.exe" /win32icon:"%DIR%\movo.ico" /r:System.Windows.Forms.dll /r:System.Drawing.dll "%DIR%\src\*.cs" >"%DIR%\build.log" 2>&1
if not exist "%DIR%\movo.exe" (
  "%CSC%" /nologo /optimize+ /codepage:65001 /target:exe /out:"%DIR%\movo.exe" /r:System.Windows.Forms.dll /r:System.Drawing.dll "%DIR%\src\*.cs" >"%DIR%\build.log" 2>&1
)
if not exist "%DIR%\movo.exe" (
  echo Failed to build movo.exe. Log: %DIR%\build.log
  type "%DIR%\build.log"
  goto :fail
)
echo      Building libraries web and browser into %LIB% ...
if not exist "%LIB%" mkdir "%LIB%"
"%CSC%" /nologo /optimize+ /codepage:65001 /target:library /out:"%LIB%\web.dll" /r:"%DIR%\movo.exe" "%DIR%\libsrc\Web.cs" >"%DIR%\buildlib.log" 2>&1
"%CSC%" /nologo /optimize+ /codepage:65001 /target:library /out:"%LIB%\browser.dll" /r:"%DIR%\movo.exe" /r:System.Web.Extensions.dll "%DIR%\libsrc\Browser.cs" >>"%DIR%\buildlib.log" 2>&1
if not exist "%LIB%\web.dll" echo      WARNING: library web was not built. See %DIR%\buildlib.log
if not exist "%LIB%\browser.dll" echo      WARNING: library browser was not built. See %DIR%\buildlib.log
rmdir /s /q "%DIR%\libsrc" >nul 2>&1
rmdir /s /q "%DIR%\src" >nul 2>&1
if exist "%DIR%\movo.py" del /f /q "%DIR%\movo.py" >nul 2>&1

echo [3/5] Setting up file types .mv and .mvl...
reg add "HKCU\Software\Classes\.mv" /ve /d "MovoFile" /f >nul
reg add "HKCU\Software\Classes\MovoFile" /ve /d "Movo Program" /f >nul
reg add "HKCU\Software\Classes\MovoFile\DefaultIcon" /ve /d "%DIR%\movo.ico" /f >nul
reg add "HKCU\Software\Classes\MovoFile\shell\open\command" /ve /d "\"%DIR%\movo.exe\" --pause \"%%1\"" /f >nul
reg add "HKCU\Software\Classes\.mvl" /ve /d "MovoLibFile" /f >nul
reg add "HKCU\Software\Classes\MovoLibFile" /ve /d "Movo Library" /f >nul
reg add "HKCU\Software\Classes\MovoLibFile\DefaultIcon" /ve /d "%DIR%\movolib.ico" /f >nul
reg add "HKCU\Software\Classes\MovoLibFile\shell\open\command" /ve /d "notepad.exe \"%%1\"" /f >nul
if errorlevel 1 goto :fail

echo [4/5] Creating library folder %LIB%...
if not exist "%LIB%" mkdir "%LIB%"
"%DIR%\movo.exe" --init
powershell -NoProfile -Command "$d=$env:DIR; $p=[Environment]::GetEnvironmentVariable('Path','User'); if(-not $p){$p=''}; if(($p -split ';') -notcontains $d){[Environment]::SetEnvironmentVariable('Path',($p.TrimEnd(';')+';'+$d).TrimStart(';'),'User')}" >nul 2>&1

set "ADD=%~dp0movo-addons"
if not exist "%ADD%\library\Host.mvl" goto :noadd
echo      Installing add-ons Https, Host and .mvs from %ADD% ...
copy /y "%ADD%\library\Https.mvl" "%LIB%\Https.mvl" >nul
copy /y "%ADD%\library\Host.mvl" "%LIB%\Host.mvl" >nul
copy /y "%ADD%\mvs_run.mv" "%DIR%\mvs_run.mv" >nul
> "%DIR%\mvs.bat" echo @"%DIR%\movo.exe" "%DIR%\mvs_run.mv" %%*
reg add "HKCU\Software\Classes\.mvs" /ve /d "MovoHostFile" /f >nul
reg add "HKCU\Software\Classes\MovoHostFile" /ve /d "Movo Host" /f >nul
reg add "HKCU\Software\Classes\MovoHostFile\DefaultIcon" /ve /d "%DIR%\movo.ico" /f >nul
reg add "HKCU\Software\Classes\MovoHostFile\shell\open\command" /ve /d "\"%DIR%\movo.exe\" --pause \"%DIR%\mvs_run.mv\" \"%%1\"" /f >nul
reg add "HKCU\Software\Classes\MovoHostFile\shell\edit\command" /ve /d "notepad.exe \"%%1\"" /f >nul
goto :addok
:noadd
echo      WARNING: folder movo-addons was not found next to this file, so Https, Host and .mvs were not installed.
echo      Put the folder movo-addons next to Movo.bat and run it again.
:addok
echo [5/5] Refreshing icons...
ie4uinit.exe -ClearIconCache >nul 2>&1
ie4uinit.exe -show >nul 2>&1

echo.
echo Done! Movo 1.1 now runs ON ITS OWN: no Python, no C++, nothing else needed.
echo .mv files get the crab icon and double-click runs them directly with movo.exe.
echo If the icon did not change, restart Explorer or the PC.
echo Interpreter: %DIR%\movo.exe   ^(from a command prompt: movo file.mv^)
echo Libraries live here: %LIB%  ^(put your own as name.mvl^)
echo Libraries web and browser are installed in %LIB%  ^(web.dll, browser.dll^). Use them with:  put.here web   /   put.here browser
echo Add-ons: put.here Https  /  put.here Host   ^(separate files in %LIB%^).  Host files: double-click a .mvs file or run:  mvs file.mvs
echo The word  import  does NOT work in Movo - always use  put.here NAME
echo Download a library from the online list:  movo install NAME   ^(open a NEW command prompt first^)
echo.
pause
exit /b 0

:fail
echo.
echo ERROR during installation. Please take a screenshot of this window.
pause
exit /b 1

:extract
rem %1 = block label, %2 = where to save
set "B64=%TEMP%\movo_%1.b64"
if exist "%B64%" del "%B64%"
for /f "tokens=2 delims=:" %%L in ('findstr /b /c:":::%1:" "%~f0"') do >>"%B64%" echo %%L
if not exist "%B64%" (
  echo Could not read block %1 from the file.
  exit /b 1
)
certutil -f -decode "%B64%" %2 >nul
set "RC=%ERRORLEVEL%"
del "%B64%" >nul 2>&1
if not "%RC%"=="0" (
  echo certutil could not unpack %1 ^(code %RC%^).
  exit /b 1
)
exit /b 0

